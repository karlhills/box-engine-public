{
  "colors": {
    "accent": "#ff9a3d",
    "panel": "#1a1210e6",
    "health": "#e5483a"
  },
  "focus_ring": { "color": "#ff9a3d", "width": 3, "offset": 4 },
  "styles": {
    "button": { "min_width": 420, "focus": { "background": "$accent", "text_color": "#1b1006" } },
    "hud": { "background": "#00000080", "radius": 10, "padding": [12, 18], "gap": 6 },
    "health_bar": { "fill_color": "$health", "width": 280, "control_height": 16 },
    "score": { "text_size": 32 },
    "toast": { "background": "#000000b0", "radius": 10, "padding": [10, 18] },
    "area": { "text_size": 52, "text_color": "#ffe2bf", "background": "#00000060", "radius": 12, "padding": [12, 28] },
    "title": { "text_size": 44 },
    "dialogue": { "min_width": 980, "max_width": 980, "gap": 16 },
    "speaker": { "text_size": 28, "text_color": "$accent" },
    "line": { "text_size": 30 },
    "fade": { "background": "#000000", "width": "100%", "height": "100%" }
  }
}
